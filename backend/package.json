{
  "name": "backend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.json",
    "prisma:generate": "prisma generate --schema ../database/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema ../database/schema.prisma",
