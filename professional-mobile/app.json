{
  "expo": {
    "name": "Bocado de Nutrição — Profissional",
    "slug": "bocado-de-nutricao-profissional",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "extra": {
      "apiUrl": "http://localhost:3000",
      "eas": {
        "projectId": "PREENCHER_APOS_EAS_INIT"
      }
    },
    "ios": {
      "bundleIdentifier": "com.bocadodenutricao.profissional",
      "supportsTablet": true,
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Usamos Bluetooth para conectar com a balança de bioimpedância durante a avaliação física.",
        "NSUserNotificationsUsageDescription": "Usamos notificações para avisar sobre relatórios, avaliações e planos liberados aos seus clientes."
      }
    },
    "android": {
      "package": "com.bocadodenutricao.profissional",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["BLUETOOTH_SCAN", "BLUETOOTH_CONNECT"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-notifications"]
  }
}
