// Fase 16 — Notificações
// ---------------------------------------------------------------------------

enum DeviceTokenPlatform {
  ios
  android
}

// Dono é Client OU Professional, nunca os dois nem nenhum — garantido na
// camada de serviço (NotificationDeviceTokensService), não no banco, pelo
// mesmo motivo de "Prisma só se necessário": todo write passa por um único
// service interno, nunca por escrita externa/bruta.
model DeviceToken {
  id             String              @id @default(uuid())
  clientId       String?             @map("client_id")
  professionalId String?             @map("professional_id")
  platform       DeviceTokenPlatform
  token          String              @unique
  createdAt      DateTime            @default(now()) @map("created_at")
  revokedAt      DateTime?           @map("revoked_at")

  client       Client?       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  logs         NotificationLog[]

  @@index([clientId, revokedAt])
  @@index([professionalId, revokedAt])
  @@map("device_tokens")
}

// Catálogo fechado — só os eventos aprovados na Fase 16. Qualquer evento
// novo exige desenho próprio (mesma regra já usada em AiFeatureKey/
// DeviceMetricType).
enum NotificationEventType {
  report_ready
  evaluation_released
  diet_published
  workout_published
  message_received
  appointment_reminder
}

model NotificationPreference {
  id             String                @id @default(uuid())
  clientId       String?               @map("client_id")
  professionalId String?               @map("professional_id")
  eventType      NotificationEventType @map("event_type")
  enabled        Boolean               @default(true)
  updatedAt      DateTime              @default(now()) @updatedAt @map("updated_at")

  client       Client?       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: Restrict)

  // NULL não colide em unique constraint no Postgres — cada par funciona
  // isoladamente para o dono que de fato preenche aquele campo.
  @@unique([clientId, eventType])
  @@unique([professionalId, eventType])
  @@map("notification_preferences")
}

enum NotificationLogStatus {
  sent
  failed
  skipped_preference
}

// Mesmo papel que um *AuditLog (quem/o quê/quando/resultado) — aqui é a
// própria tabela de dado, porque o conteúdo da notificação é sempre um
// template fixo por eventType, nunca texto livre ou dado de saúde; não há
// separação dado-sensível/auditoria a fazer, ao contrário de AiInteractionLog.
model NotificationLog {
  id             String                @id @default(uuid())
  clientId       String?               @map("client_id")
  professionalId String?               @map("professional_id")
  eventType      NotificationEventType @map("event_type")
  status         NotificationLogStatus
  deviceTokenId  String?               @map("device_token_id")
  errorMessage   String?               @map("error_message")
  createdAt      DateTime              @default(now()) @map("created_at")

  client       Client?      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  deviceToken  DeviceToken? @relation(fields: [deviceTokenId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
  @@index([professionalId, createdAt])
  @@map("notification_logs")
}

// ---------------------------------------------------------------------------
// Fase 17 — Comunicação
// ---------------------------------------------------------------------------

// Uma thread por par profissional↔cliente — nunca mais de uma (garantido
// pelo @@unique, não por lógica de aplicação).
model MessageThread {
  id             String   @id @default(uuid())
  clientId       String   @map("client_id")
  professionalId String   @map("professional_id")
  createdAt      DateTime @default(now()) @map("created_at")

  client       Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  professional Professional      @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  messages     Message[]
  auditLogs    MessageAuditLog[]

  @@unique([clientId, professionalId])
  @@map("message_threads")
}

enum MessageSenderRole {
  professional
  client
}

model Message {
  id         String            @id @default(uuid())
  threadId   String            @map("thread_id")
  senderRole MessageSenderRole @map("sender_role")
  body       String            @db.Text
  // Preenchido quando o destinatário (quem NÃO enviou) abre a thread —
  // nunca setado pelo próprio remetente.
  readAt     DateTime?         @map("read_at")
  createdAt  DateTime          @default(now()) @map("created_at")

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Restrict)

  @@index([threadId, createdAt])
  @@map("messages")
}

enum MessageAuditAction {
  thread_created
  message_sent
  thread_read
}

// Mesmo papel que ReportAuditLog: quem/o quê/quando, nunca o conteúdo da
// mensagem (isso vive só em Message.body).
model MessageAuditLog {
  id             String             @id @default(uuid())
  professionalId String             @map("professional_id")
  clientId       String             @map("client_id")
  threadId       String?            @map("thread_id")
  messageId      String?            @map("message_id")
  action         MessageAuditAction
  ipAddress      String?            @map("ip_address")
  createdAt      DateTime           @default(now()) @map("created_at")

  professional Professional   @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  client       Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  thread       MessageThread? @relation(fields: [threadId], references: [id], onDelete: SetNull)

  @@index([threadId])
  @@index([professionalId, createdAt])
  @@map("message_audit_logs")
}

// ---------------------------------------------------------------------------
// Fase 18 — Agenda e consultas
// ---------------------------------------------------------------------------

// Slot discreto (não uma regra recorrente) — o profissional cria cada
// horário individualmente. isBooked evita ter que consultar Appointment
// toda vez que se lista disponibilidade; a garantia real de "no máximo uma
// consulta ATIVA por slot" é um índice único parcial adicionado à mão na
// migration (WHERE status != 'cancelled') — não este campo (só projeção de
// leitura) nem um @unique bloqueante (uma consulta cancelada continua
// existindo para histórico, então não pode "travar" o slot para sempre).
// `appointments` é Appointment[] (não Appointment?) só porque o Prisma
// exige @unique no escalar pra modelar 1:1 — a relação real, garantida no
// banco, continua sendo "no máximo um agendamento ativo por slot".
model AvailabilitySlot {
  id             String   @id @default(uuid())
  professionalId String   @map("professional_id")
  startAt        DateTime @map("start_at")
  endAt          DateTime @map("end_at")
  isBooked       Boolean  @default(false) @map("is_booked")
  createdAt      DateTime @default(now()) @map("created_at")

  professional Professional  @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  appointments Appointment[]

  @@index([professionalId, startAt])
  @@map("availability_slots")
}

// Catálogo fechado e deliberadamente mínimo (Fase 18): sem "completed" —
// "passada" é derivado de scheduledAt no momento da leitura, não um estado
// armazenado (nenhuma rotina fica responsável por transicionar status).
enum AppointmentStatus {
  scheduled
  confirmed
  cancelled
}

// slotId NÃO é @unique aqui de propósito: uma consulta cancelada continua
// existindo (histórico/auditoria), então um @unique bloquearia o slot para
// sempre depois do primeiro cancelamento. A garantia real de "no máximo uma
// consulta ATIVA por slot" é um índice único PARCIAL adicionado à mão na
// migration (`WHERE status != 'cancelled'`) — Prisma não expressa índice
// parcial declarativamente. Ver migration 20260917121643_fix_slot_uniqueness.
model Appointment {
  id              String            @id @default(uuid())
  clientId        String            @map("client_id")
  professionalId  String            @map("professional_id")
  slotId          String            @map("slot_id")
  // Redundante com slot.startAt de propósito: permite indexar/filtrar por
  // data sem join, e preserva o horário original mesmo se o slot algum dia
  // puder ser editado.
  scheduledAt     DateTime          @map("scheduled_at")
  durationMinutes Int               @map("duration_minutes")
  status          AppointmentStatus @default(scheduled)
  notes           String?
  // Preenchido pelo job de lembrete (ver AppointmentReminderService) —
  // garante que o mesmo lembrete nunca é disparado duas vezes.
  reminderSentAt  DateTime?         @map("reminder_sent_at")
  cancelledAt     DateTime?         @map("cancelled_at")
  createdAt       DateTime          @default(now()) @map("created_at")

  client       Client                 @relation(fields: [clientId], references: [id], onDelete: Restrict)
  professional Professional           @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  slot         AvailabilitySlot       @relation(fields: [slotId], references: [id], onDelete: Restrict)
  auditLogs    AppointmentAuditLog[]

  @@index([slotId])
  @@index([professionalId, scheduledAt])
  @@index([clientId, scheduledAt])
  @@map("appointments")
}

enum AppointmentAuditAction {
  slot_created
  slot_removed
  appointment_created
  appointment_confirmed
  appointment_cancelled
}

// Mesmo papel que os demais *AuditLog: quem/o quê/quando, nunca conteúdo
// livre. clientId é opcional porque ações de disponibilidade (criar/
// remover slot) não têm cliente nenhum envolvido ainda.
model AppointmentAuditLog {
  id             String                 @id @default(uuid())
  professionalId String                 @map("professional_id")
  clientId       String?                @map("client_id")
  appointmentId  String?                @map("appointment_id")
  action         AppointmentAuditAction
  ipAddress      String?                @map("ip_address")
  createdAt      DateTime               @default(now()) @map("created_at")

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  appointment  Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([appointmentId])
  @@index([professionalId, createdAt])
  @@map("appointment_audit_logs")
}

// ---------------------------------------------------------------------------
// Fase 19 — LGPD operacional
// ---------------------------------------------------------------------------

// Síncrono nesta fase (o volume de dado de um cliente é pequeno — nada
// como um PDF renderizado) — a linha já nasce "ready", serve de registro
// de auditoria de quando a exportação aconteceu, não de fila real.
enum DataExportStatus {
  ready
  failed
}

model DataExportRequest {
  id          String           @id @default(uuid())
  clientId    String           @map("client_id")
  status      DataExportStatus @default(ready)
  requestedAt DateTime         @default(now()) @map("requested_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@index([clientId, requestedAt])
  @@map("data_export_requests")
}

// Um pedido por cliente (@unique) — a conta só pode ser apagada uma vez.
// A própria linha já é o registro de auditoria (quem/quando) — mesmo
// raciocínio de NotificationLog (Fase 16): sem conteúdo sensível, não
// precisa de uma *AuditLog separada.
model AccountDeletionRequest {
  id          String   @id @default(uuid())
  clientId    String   @unique @map("client_id")
  requestedAt DateTime @default(now()) @map("requested_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@map("account_deletion_requests")
}
