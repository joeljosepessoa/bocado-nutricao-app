  android_health_connect
  manufacturer_api // reservado — nenhuma API de fabricante implementada nesta fase
  manual_import
}

enum DeviceConnectionStatus {
  active
  revoked
  error
}

// Catálogo fechado — só métricas que uma fonte real (HealthKit/Health
// Connect/Heart Rate Service BLE) consegue efetivamente fornecer. Nenhuma
// adicionada "porque outro dispositivo mede isso" sem um adapter real.
enum DeviceMetricType {
  heart_rate
  resting_heart_rate
  steps
  distance
  active_calories
  sleep_session
  workout_activity
  exercise_duration
  oxygen_saturation
  body_temperature
  respiratory_rate
}

model DeviceConnection {
  id                     String                  @id @default(uuid())
  clientId               String                  @map("client_id")
  sourceType             DeviceSourceType        @map("source_type")
  driverId               String?                 @map("driver_id") // só ble_direct — id no WearableDriverRegistry
  deviceIdentifier       String?                 @map("device_identifier")
  externalAccountId      String?                 @map("external_account_id") // reservado — só manufacturer_api
