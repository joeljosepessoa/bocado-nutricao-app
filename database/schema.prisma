enum DeviceAuditAction {
  connection_created
  connection_revoked
  share_enabled
  share_disabled
  metrics_ingested
  metrics_viewed_by_professional
}

model DeviceAuditLog {
  id                 String            @id @default(uuid())
  clientId           String            @map("client_id")
  // Nulo quando a ação foi do próprio cliente (conectar/revogar/
  // compartilhar/sincronizar) — preenchido só quando um profissional agiu
  // (ex.: visualizou métricas compartilhadas). Diferente de Evaluation/
  // Report/ScaleAuditLog (sempre professionalId), porque aqui a maioria
  // das ações é iniciada pelo cliente, não pelo profissional.
  professionalId     String?           @map("professional_id")
  deviceConnectionId String?           @map("device_connection_id")
