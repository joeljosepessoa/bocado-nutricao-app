generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  professional
  client
  admin
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  passwordHash       String    @map("password_hash")
  fullName           String    @map("full_name")
  role               Role
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  privacyAcceptedAt  DateTime? @map("privacy_accepted_at")
  // Fase 15 — só usado para role=professional. Bloqueia login (checado em
  // AuthService.login) e é sempre acompanhado de revokeAllForUser na
  // suspensão, o mesmo mecanismo já usado pelo reset de senha (Fase 13).
  suspendedAt        DateTime? @map("suspended_at")
  // Fase 19 — marca que email/fullName/passwordHash foram substituídos por
  // um placeholder irreversível (exclusão de conta LGPD). A linha em si
  // nunca é apagada — preserva a integridade referencial das tabelas do
  // profissional (avaliações, dietas, treinos, etc. continuam existindo).
  anonymizedAt       DateTime? @map("anonymized_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  professional  Professional?
  client        Client?
  refreshTokens RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  adminAuditLogs AdminAuditLog[]

  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  familyId   String    @map("family_id")
  tokenHash  String    @unique @map("token_hash")
  issuedAt   DateTime  @default(now()) @map("issued_at")
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  revokedAt  DateTime? @map("revoked_at")
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// Fase 13 — recuperação de senha. Mesmo padrão de segurança de
// RefreshToken (token opaco, só o hash SHA-256 é armazenado, uso único),
// deliberadamente mais simples: sem família/rotação, porque não é uma
// cadeia de sessão — é um token de uso único que expira rápido.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  ipAddress String?   @map("ip_address")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_reset_tokens")
}

model Professional {
  id                     String  @id
  professionalRegister   String? @map("professional_register")
  // Fase 12: consentimento próprio, separado do do cliente — autoriza só
  // o uso da ferramenta de IA pelo profissional, nunca o processamento do
  // dado de um cliente específico (isso é Client.aiDataProcessingConsentAt).
  aiFeaturesConsentAt    DateTime? @map("ai_features_consent_at")

  user             User                 @relation(fields: [id], references: [id])
  clients          Client[]
  evaluations      PhysicalEvaluation[]
  auditLogs        EvaluationAuditLog[]
  createdFoods       Food[]               @relation("FoodCreatedBy")
  privateFoods       Food[]               @relation("FoodOwner")
  foodSubstitutions  FoodSubstitution[]
  diets              Diet[]
  dietAuditLogs      DietAuditLog[]
  createdExercises   Exercise[]           @relation("ExerciseCreatedBy")
  privateExercises   Exercise[]           @relation("ExerciseOwner")
  workouts           Workout[]
  workoutAuditLogs   WorkoutAuditLog[]
  workoutExecutionLogs WorkoutExecutionLog[]
  reports            Report[]
  reportAuditLogs    ReportAuditLog[]
  scaleReadings      ScaleReading[]
  scaleAuditLogs     ScaleAuditLog[]
  deviceAuditLogs    DeviceAuditLog[]
  aiInteractionLogs  AiInteractionLog[]
  aiAuditLogs        AiAuditLog[]
  deviceTokens             DeviceToken[]
  notificationPreferences  NotificationPreference[]
  notificationLogs         NotificationLog[]
  messageThreads           MessageThread[]
  messageAuditLogs         MessageAuditLog[]
  availabilitySlots        AvailabilitySlot[]
  appointments             Appointment[]
  appointmentAuditLogs     AppointmentAuditLog[]

  @@map("professionals")
}

enum ClientStatus {
  active
  inactive
  archived
}

model Client {
  id             String       @id
  professionalId String       @map("professional_id")
  birthDate      DateTime?    @map("birth_date")
  phone          String?
  gender         String?
  notes          String?      @db.Text
  status         ClientStatus @default(active)
  archivedAt     DateTime?    @map("archived_at")
  // Fase 11: consentimento específico para coleta de dados de dispositivos/
  // wearables — deliberadamente separado de User.privacyAcceptedAt (esse
  // cobre só dieta/treino/evolução; coleta contínua de terceiros exige
  // finalidade própria, LGPD).
  deviceDataConsentAt DateTime?    @map("device_data_consent_at")
  // Fase 12: consentimento específico para o PRÓPRIO dado do cliente ser
  // processado por IA — nunca implícito em privacyAcceptedAt nem em
  // deviceDataConsentAt (finalidades diferentes, LGPD exige consentimento
  // por finalidade). Independente de Professional.aiFeaturesConsentAt.
  aiDataProcessingConsentAt DateTime? @map("ai_data_processing_consent_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at")

  user               User                  @relation(fields: [id], references: [id])
  professional       Professional          @relation(fields: [professionalId], references: [id])
  evaluations        PhysicalEvaluation[]
  auditLogs          EvaluationAuditLog[]
  diets              Diet[]
  dietAuditLogs      DietAuditLog[]
  workouts           Workout[]
  workoutAuditLogs   WorkoutAuditLog[]
  workoutExecutionLogs WorkoutExecutionLog[]
  reports            Report[]
  reportAuditLogs    ReportAuditLog[]
  scaleReadings      ScaleReading[]
  scaleAuditLogs     ScaleAuditLog[]
  deviceConnections  DeviceConnection[]
  deviceMetricSamples DeviceMetricSample[]
  deviceAuditLogs    DeviceAuditLog[]
  aiInteractionLogs  AiInteractionLog[]
  aiAuditLogs        AiAuditLog[]
  deviceTokens             DeviceToken[]
  notificationPreferences  NotificationPreference[]
  notificationLogs         NotificationLog[]
  messageThreads           MessageThread[]
  messageAuditLogs         MessageAuditLog[]
  appointments             Appointment[]
  appointmentAuditLogs     AppointmentAuditLog[]
  dataExportRequests       DataExportRequest[]
  accountDeletionRequest   AccountDeletionRequest?

  @@index([professionalId, status])
  @@map("clients")
}

// ---------------------------------------------------------------------------
// Fase 4 — Avaliação física
// ---------------------------------------------------------------------------

enum EvaluationBiologicalSex {
  male
  female
}

enum BodyFatSource {
  skinfolds
  bioimpedance
  manual
}

enum BioimpedanceOrigin {
  manual
  device_confirmed // Fase 10 (BLE) — leitura de balança confirmada pelo profissional
}

enum PhotoAngle {
  front
  side_right
  back
  side_left
}

enum EvaluationAuditAction {
  created
  read
  updated
  listed
  compared
  photo_uploaded
  photo_read
  photo_deleted
  released
}

model Protocol {
  id                     String    @id @default(uuid())
  code                   String    @unique
  name                   String
  description            String    @db.Text
  requiredSkinfoldSites  String[]  @map("required_skinfold_sites")
  sexSpecific            Boolean   @default(false) @map("sex_specific")
  version                Int
  supersededByProtocolId String?   @map("superseded_by_protocol_id")
  createdAt              DateTime  @default(now()) @map("created_at")

  supersededBy Protocol?  @relation("ProtocolVersion", fields: [supersededByProtocolId], references: [id])
  supersedes   Protocol[] @relation("ProtocolVersion")
  evaluations  PhysicalEvaluation[]

  @@map("protocols")
}

model PhysicalEvaluation {
  id                          String                   @id @default(uuid())
  clientId                    String                   @map("client_id")
  professionalId              String                   @map("professional_id")
  evaluatedAt                 DateTime                 @map("evaluated_at")
  ageAtEvaluation              Int?                     @map("age_at_evaluation")
  biologicalSexForCalculation EvaluationBiologicalSex? @map("biological_sex_for_calculation")
  heightCm                    Float                    @map("height_cm")
  weightKg                    Float?                   @map("weight_kg")
  protocolId                  String?                  @map("protocol_id")
  bloodPressureSystolic       Int?                     @map("blood_pressure_systolic")
  bloodPressureDiastolic      Int?                     @map("blood_pressure_diastolic")
  heartRate                   Int?                     @map("heart_rate")
  glucose                     Float?
  notes                       String?                  @db.Text
  releasedToClientAt          DateTime?                @map("released_to_client_at")
  createdAt                   DateTime                 @default(now()) @map("created_at")
  updatedAt                   DateTime                 @default(now()) @updatedAt @map("updated_at")

  client       Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  professional Professional  @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  protocol     Protocol?     @relation(fields: [protocolId], references: [id])

  measurements      Measurements?
  skinfolds         Skinfolds?
  bioimpedance      Bioimpedance?
  calculatedMetrics CalculatedMetrics?
  photos            BodyPhoto[]
  auditLogs         EvaluationAuditLog[]
  reports           Report[]
  scaleReadings     ScaleReading[]
  scaleAuditLogs    ScaleAuditLog[]

  @@index([clientId, evaluatedAt])
  @@index([professionalId])
  @@map("physical_evaluations")
}

model Measurements {
  id             String  @id @default(uuid())
  evaluationId   String  @unique @map("evaluation_id")
  chestCm        Float?  @map("chest_cm")
  waistCm        Float?  @map("waist_cm")
  abdomenCm      Float?  @map("abdomen_cm")
  hipCm          Float?  @map("hip_cm")
  armRightCm     Float?  @map("arm_right_cm")
  armLeftCm      Float?  @map("arm_left_cm")
  forearmRightCm Float?  @map("forearm_right_cm")
  forearmLeftCm  Float?  @map("forearm_left_cm")
  thighRightCm   Float?  @map("thigh_right_cm")
  thighLeftCm    Float?  @map("thigh_left_cm")
  calfRightCm    Float?  @map("calf_right_cm")
  calfLeftCm     Float?  @map("calf_left_cm")
  wristCm        Float?  @map("wrist_cm")
  femurBicondylarCm Float? @map("femur_bicondylar_cm")

  evaluation PhysicalEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Restrict)

  @@map("measurements")
}

model Skinfolds {
  id             String  @id @default(uuid())
  evaluationId   String  @unique @map("evaluation_id")
  chestMm        Float?  @map("chest_mm")
  axillaryMidMm  Float?  @map("axillary_mid_mm")
  subscapularMm  Float?  @map("subscapular_mm")
  bicepsMm       Float?  @map("biceps_mm")
  tricepsMm      Float?  @map("triceps_mm")
  abdominalMm    Float?  @map("abdominal_mm")
  suprailiacMm   Float?  @map("suprailiac_mm")
  thighMm        Float?  @map("thigh_mm")
  calfMm         Float?  @map("calf_mm")

  evaluation PhysicalEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Restrict)

  @@map("skinfolds")
}

model Bioimpedance {
  id                     String             @id @default(uuid())
  evaluationId           String             @unique @map("evaluation_id")
  origin                 BioimpedanceOrigin
  recordedAt             DateTime           @default(now()) @map("recorded_at")
  weightKg               Float?             @map("weight_kg")
  bodyFatPercent         Float?             @map("body_fat_percent")
  fatMassKg              Float?             @map("fat_mass_kg")
  leanMassKg             Float?             @map("lean_mass_kg")
  skeletalMuscleMassKg   Float?             @map("skeletal_muscle_mass_kg")
  muscleMassKg           Float?             @map("muscle_mass_kg")
  bodyWaterPercent       Float?             @map("body_water_percent")
  visceralFatLevel       Float?             @map("visceral_fat_level")
  basalMetabolicRateKcal Float?             @map("basal_metabolic_rate_kcal")
  bodyAgeYears           Int?               @map("body_age_years")
  boneMassKg             Float?             @map("bone_mass_kg")
  segmentalData          Json?              @map("segmental_data")
  impedanceData          Json?              @map("impedance_data")

  evaluation PhysicalEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Restrict)

  @@map("bioimpedance")
}

model CalculatedMetrics {
  id                   String         @id @default(uuid())
  evaluationId         String         @unique @map("evaluation_id")
  bmi                  Float?
  bmiClassification    String?        @map("bmi_classification")
  waistHipRatio        Float?         @map("waist_hip_ratio")
  bodyFatPercent       Float?         @map("body_fat_percent")
  bodyFatPercentSource BodyFatSource? @map("body_fat_percent_source")
  fatMassKg            Float?         @map("fat_mass_kg")
  leanMassKg           Float?         @map("lean_mass_kg")
  protocolVersionUsed  String?        @map("protocol_version_used")
  calculatedAt         DateTime       @default(now()) @map("calculated_at")

  evaluation PhysicalEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Restrict)

  @@map("calculated_metrics")
}

model BodyPhoto {
  id                       String     @id @default(uuid())
  evaluationId             String     @map("evaluation_id")
  angle                    PhotoAngle
  storageKey               String     @map("storage_key")
  contentType              String     @map("content_type")
  sizeBytes                Int        @map("size_bytes")
  uploadedByProfessionalId String     @map("uploaded_by_professional_id")
  capturedAt               DateTime?  @map("captured_at")
  createdAt                DateTime   @default(now()) @map("created_at")

  evaluation PhysicalEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Restrict)

  @@index([evaluationId])
  @@map("body_photos")
}

model EvaluationAuditLog {
  id             String                @id @default(uuid())
  professionalId String                @map("professional_id")
  clientId       String                @map("client_id")
  evaluationId   String?               @map("evaluation_id")
  action         EvaluationAuditAction
  ipAddress      String?               @map("ip_address")
  createdAt      DateTime              @default(now()) @map("created_at")

  professional Professional        @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  client       Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  evaluation   PhysicalEvaluation? @relation(fields: [evaluationId], references: [id], onDelete: SetNull)

  @@index([evaluationId])
  @@index([professionalId, createdAt])
  @@map("evaluation_audit_logs")
}

// ---------------------------------------------------------------------------
// Fase 5 — Dieta
// ---------------------------------------------------------------------------

enum FoodScope {
  global
  private
}

enum DietStatus {
  active
  archived
}

enum DietVersionStatus {
  draft
  published
  superseded
}

enum NutritionUnit {
  g
  ml
  unit
  tablespoon
  teaspoon
  cup
  slice
}

enum DietAuditAction {
  created
  updated
  version_created
  version_updated
  published
  archived
  meal_added
  meal_updated
  meal_removed
  food_added
  food_updated
  food_removed
  read
  listed
}

model Food {
  id                     String    @id @default(uuid())
  name                   String
  scope                  FoodScope @default(global)
  ownerProfessionalId    String?   @map("owner_professional_id") // só quando scope = private
  baseUnit               NutritionUnit @map("base_unit") // g ou ml, validado no DTO
  kcalPer100             Float     @map("kcal_per_100")
  proteinGPer100         Float     @map("protein_g_per_100")
  carbGPer100            Float     @map("carb_g_per_100")
  fatGPer100             Float     @map("fat_g_per_100")
  fiberGPer100           Float?    @map("fiber_g_per_100")
  source                 String    @default("manual")
  // Fase 15 — null = pendente de moderação (só o próprio criador enxerga,
  // ver visibilityFilter em foods.service.ts). Preenchido = visível a todos.
  // Migration faz backfill retroativo em todo Food global já existente.
  approvedAt             DateTime? @map("approved_at")
  createdByProfessionalId String   @map("created_by_professional_id")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at")

  owner     Professional? @relation("FoodOwner", fields: [ownerProfessionalId], references: [id], onDelete: Restrict)
  createdBy Professional  @relation("FoodCreatedBy", fields: [createdByProfessionalId], references: [id], onDelete: Restrict)

  unitConversions            FoodUnitConversion[]
  mealFoods                  MealFood[]
  substitutionsAsOriginal    FoodSubstitution[]   @relation("OriginalFood")
  substitutionsAsSubstitute  FoodSubstitution[]   @relation("SubstituteFood")

  @@index([name])
  @@index([scope, ownerProfessionalId])
  @@map("foods")
}

model FoodUnitConversion {
  id              String        @id @default(uuid())
  foodId          String        @map("food_id")
  unit            NutritionUnit
  gramsEquivalent Float         @map("grams_equivalent")

  food Food @relation(fields: [foodId], references: [id], onDelete: Restrict)

  @@unique([foodId, unit])
  @@map("food_unit_conversions")
}

model FoodSubstitution {
  id                      String        @id @default(uuid())
  originalFoodId          String        @map("original_food_id")
  substituteFoodId        String        @map("substitute_food_id")
  substituteQuantity      Float         @map("substitute_quantity")
  substituteUnit          NutritionUnit @map("substitute_unit")
  substituteKcal          Float?        @map("substitute_kcal")
  substituteProteinG      Float?        @map("substitute_protein_g")
  substituteCarbG         Float?        @map("substitute_carb_g")
  substituteFatG          Float?        @map("substitute_fat_g")
  notes                   String?
  createdByProfessionalId String        @map("created_by_professional_id")
  createdAt               DateTime      @default(now()) @map("created_at")

  originalFood    Food         @relation("OriginalFood", fields: [originalFoodId], references: [id], onDelete: Restrict)
  substituteFood  Food         @relation("SubstituteFood", fields: [substituteFoodId], references: [id], onDelete: Restrict)
  createdBy       Professional @relation(fields: [createdByProfessionalId], references: [id], onDelete: Restrict)

  @@index([originalFoodId])
  @@map("food_substitutions")
}

model Diet {
  id             String     @id @default(uuid())
  clientId       String     @map("client_id")
  professionalId String     @map("professional_id")
  status         DietStatus @default(active)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @default(now()) @updatedAt @map("updated_at")

  client       Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  professional Professional  @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  versions     DietVersion[]
  auditLogs    DietAuditLog[]

  @@index([clientId])
  @@index([professionalId])
  @@map("diets")
}

model DietVersion {
  id                      String             @id @default(uuid())
  dietId                  String             @map("diet_id")
  versionNumber           Int                @map("version_number")
  status                  DietVersionStatus  @default(draft)
  startDate               DateTime?          @map("start_date")
  endDate                 DateTime?          @map("end_date")
  notes                   String?            @db.Text
  objective               String?
  targetCalories          Float?             @map("target_calories")
  targetProteinG          Float?             @map("target_protein_g")
  targetCarbG             Float?             @map("target_carb_g")
  targetFatG              Float?             @map("target_fat_g")
  createdByProfessionalId String             @map("created_by_professional_id")
  publishedAt             DateTime?          @map("published_at")
  supersededAt            DateTime?          @map("superseded_at")
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @default(now()) @updatedAt @map("updated_at")

  diet      Diet           @relation(fields: [dietId], references: [id], onDelete: Restrict)
  meals     Meal[]
  auditLogs DietAuditLog[]

  @@unique([dietId, versionNumber])
  @@index([dietId, status])
  @@map("diet_versions")
}

model Meal {
  id            String   @id @default(uuid())
  dietVersionId String   @map("diet_version_id")
  name          String
  order         Int
  time          String?
  notes         String?

  dietVersion DietVersion @relation(fields: [dietVersionId], references: [id], onDelete: Restrict)
  foods       MealFood[]

  @@index([dietVersionId, order])
  @@map("meals")
}

model MealFood {
  id              String        @id @default(uuid())
  mealId          String        @map("meal_id")
  foodId          String        @map("food_id")
  order           Int
  quantity        Float
  unit            NutritionUnit
  gramsEquivalent Float?        @map("grams_equivalent")
  kcal            Float?
  proteinG        Float?        @map("protein_g")
  carbG           Float?        @map("carb_g")
  fatG            Float?        @map("fat_g")
  fiberG          Float?        @map("fiber_g")
  notes           String?

  meal Meal @relation(fields: [mealId], references: [id], onDelete: Restrict)
  food Food @relation(fields: [foodId], references: [id], onDelete: Restrict)

  @@index([mealId, order])
  @@map("meal_foods")
}

model DietAuditLog {
  id             String           @id @default(uuid())
  professionalId String           @map("professional_id")
  clientId       String           @map("client_id")
  dietId         String           @map("diet_id")
  dietVersionId  String?          @map("diet_version_id")
  action         DietAuditAction
  ipAddress      String?          @map("ip_address")
  createdAt      DateTime         @default(now()) @map("created_at")

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  diet         Diet         @relation(fields: [dietId], references: [id], onDelete: Restrict)
  dietVersion  DietVersion? @relation(fields: [dietVersionId], references: [id], onDelete: SetNull)

  @@index([dietId, createdAt])
  @@index([professionalId, createdAt])
  @@map("diet_audit_logs")
}

// ---------------------------------------------------------------------------
// Fase 6 — Treino
// ---------------------------------------------------------------------------

enum ExerciseType {
  strength
  cardio
  mobility
  stretching
  bodyweight
  other
}

enum ExerciseScope {
  global
  private
}

enum LoadUnit {
  kg
  lb
  bodyweight
  band_level
  other
}

enum WorkoutStatus {
  active
  archived
}

enum WorkoutVersionStatus {
  draft
  published
  superseded
}

enum WorkoutAuditAction {
  created
  updated
  version_created
  version_updated
  published
  archived
  day_added
  day_updated
  day_removed
  exercise_added
  exercise_updated
  exercise_removed
  set_added
  set_updated
  set_removed
  execution_logged
  read
  listed
  compared
}

model Exercise {
  id                      String        @id @default(uuid())
  name                    String
  description             String?       @db.Text
  muscleGroup             String?       @map("muscle_group")
  equipment               String?
  instructions            String?       @db.Text
  type                    ExerciseType
  scope                   ExerciseScope @default(global)
  ownerProfessionalId     String?       @map("owner_professional_id")
  videoUrl                String?       @map("video_url")
  imageUrl                String?       @map("image_url")
  // Fase 15 — mesmo papel de Food.approvedAt (ver comentário lá).
  approvedAt              DateTime?     @map("approved_at")
  createdByProfessionalId String        @map("created_by_professional_id")
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @default(now()) @updatedAt @map("updated_at")

  owner     Professional? @relation("ExerciseOwner", fields: [ownerProfessionalId], references: [id], onDelete: Restrict)
  createdBy Professional  @relation("ExerciseCreatedBy", fields: [createdByProfessionalId], references: [id], onDelete: Restrict)

  workoutExercises WorkoutExercise[]

  @@index([name])
  @@index([scope, ownerProfessionalId])
  @@map("exercises")
}

model Workout {
  id             String        @id @default(uuid())
  clientId       String        @map("client_id")
  professionalId String        @map("professional_id")
  status         WorkoutStatus @default(active)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at")

  client       Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  professional Professional      @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  versions     WorkoutVersion[]
  auditLogs    WorkoutAuditLog[]

  @@index([clientId])
  @@index([professionalId])
  @@map("workouts")
}

model WorkoutVersion {
  id                      String                @id @default(uuid())
  workoutId               String                @map("workout_id")
  versionNumber           Int                   @map("version_number")
  status                  WorkoutVersionStatus  @default(draft)
  startDate               DateTime?             @map("start_date")
  endDate                 DateTime?             @map("end_date")
  objective               String?
  notes                   String?               @db.Text
  createdByProfessionalId String                @map("created_by_professional_id")
  publishedAt             DateTime?             @map("published_at")
  supersededAt            DateTime?             @map("superseded_at")
  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @default(now()) @updatedAt @map("updated_at")

  workout        Workout               @relation(fields: [workoutId], references: [id], onDelete: Restrict)
  days           WorkoutDay[]
  auditLogs      WorkoutAuditLog[]
  executionLogs  WorkoutExecutionLog[]

  @@unique([workoutId, versionNumber])
  @@index([workoutId, status])
  @@map("workout_versions")
}

model WorkoutDay {
  id              String   @id @default(uuid())
  workoutVersionId String  @map("workout_version_id")
  name            String
  order           Int
  notes           String?

  workoutVersion WorkoutVersion        @relation(fields: [workoutVersionId], references: [id], onDelete: Restrict)
  exercises      WorkoutExercise[]
  executionLogs  WorkoutExecutionLog[]

  @@index([workoutVersionId, order])
  @@map("workout_days")
}

model WorkoutExercise {
  id           String  @id @default(uuid())
  workoutDayId String  @map("workout_day_id")
  exerciseId   String  @map("exercise_id")
  order        Int
  notes        String?

  workoutDay      WorkoutDay            @relation(fields: [workoutDayId], references: [id], onDelete: Restrict)
  exercise        Exercise              @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  sets            WorkoutSet[]
  executionSets   WorkoutExecutionSet[]

  @@index([workoutDayId, order])
  @@map("workout_exercises")
}

model WorkoutSet {
  id                String    @id @default(uuid())
  workoutExerciseId String    @map("workout_exercise_id")
  order             Int
  reps              Int?
  loadValue         Float?    @map("load_value")
  loadUnit          LoadUnit? @map("load_unit")
  durationSeconds   Int?      @map("duration_seconds")
  distanceMeters    Float?    @map("distance_meters")
  restSeconds       Int?      @map("rest_seconds")
  tempo             String?
  notes             String?

  workoutExercise WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Restrict)

  @@index([workoutExerciseId, order])
  @@map("workout_sets")
}

model WorkoutExecutionLog {
  id                     String    @id @default(uuid())
  clientId               String    @map("client_id")
  workoutDayId           String    @map("workout_day_id")
  workoutVersionId       String    @map("workout_version_id")
  loggedByProfessionalId String?   @map("logged_by_professional_id")
  performedAt            DateTime  @map("performed_at")
  notes                  String?
  createdAt              DateTime  @default(now()) @map("created_at")

  client         Client                @relation(fields: [clientId], references: [id], onDelete: Restrict)
  workoutDay     WorkoutDay            @relation(fields: [workoutDayId], references: [id], onDelete: Restrict)
  workoutVersion WorkoutVersion        @relation(fields: [workoutVersionId], references: [id], onDelete: Restrict)
  loggedBy       Professional?         @relation(fields: [loggedByProfessionalId], references: [id], onDelete: Restrict)
  sets           WorkoutExecutionSet[]

  @@index([clientId, performedAt])
  @@index([workoutDayId])
  @@map("workout_execution_logs")
}

model WorkoutExecutionSet {
  id                String    @id @default(uuid())
  executionLogId    String    @map("execution_log_id")
  workoutExerciseId String    @map("workout_exercise_id")
  setOrder          Int       @map("set_order")
  repsPerformed     Int?      @map("reps_performed")
  loadValue         Float?    @map("load_value")
  loadUnit          LoadUnit? @map("load_unit")
  durationSeconds   Int?      @map("duration_seconds")
  distanceMeters    Float?    @map("distance_meters")
  perceivedEffort   Int?      @map("perceived_effort")
  notes             String?

  executionLog    WorkoutExecutionLog @relation(fields: [executionLogId], references: [id], onDelete: Restrict)
  workoutExercise WorkoutExercise     @relation(fields: [workoutExerciseId], references: [id], onDelete: Restrict)

  @@index([executionLogId])
  @@map("workout_execution_sets")
}

model WorkoutAuditLog {
  id                String              @id @default(uuid())
  professionalId    String              @map("professional_id")
  clientId          String              @map("client_id")
  workoutId         String              @map("workout_id")
  workoutVersionId  String?             @map("workout_version_id")
  action            WorkoutAuditAction
  ipAddress         String?             @map("ip_address")
  createdAt         DateTime            @default(now()) @map("created_at")

  professional   Professional    @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  client         Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  workout        Workout         @relation(fields: [workoutId], references: [id], onDelete: Restrict)
  workoutVersion WorkoutVersion? @relation(fields: [workoutVersionId], references: [id], onDelete: SetNull)

  @@index([workoutId, createdAt])
  @@index([professionalId, createdAt])
  @@map("workout_audit_logs")
