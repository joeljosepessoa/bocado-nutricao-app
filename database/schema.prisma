enum ReportAudience {
  professional // PDF técnico completo — nunca visível ao cliente
  client       // PDF restrito — mesmo allowlist de PhysicalEvaluationClientSummaryDto (Fase 8)
}

enum ReportStatus {
  queued     // linha criada, geração ainda não rodou
  generating // Puppeteer em execução
  ready      // storageKey preenchido, PDF disponível
  failed     // ver failureReason
}

enum ReportAuditAction {
  created
  generated
  generation_failed
  downloaded
  released
  revoked
  deleted
}

model Report {
  id                 String         @id @default(uuid())
  evaluationId       String         @map("evaluation_id")
