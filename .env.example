# =============================================================================
# Bocado de Nutrição — variáveis de ambiente
#
# Desenvolvimento: copie para backend/.env e ajuste.
# Docker Compose (docker-compose.yml): copie para .env na RAIZ do repositório.
# Nenhum valor abaixo é real — em produção gere/obtenha os seus. Guia completo:
# docs/OPERACAO.md.
# =============================================================================

# --- Banco -------------------------------------------------------------------
DATABASE_URL="postgresql://bocado:bocado@localhost:5432/bocado_dev"
# Só para o docker-compose (usuário "bocado"): a API monta a DATABASE_URL a partir dela.
POSTGRES_PASSWORD="troque-por-uma-senha-forte"

# --- Servidor ----------------------------------------------------------------
PORT=3000
# "production" ativa: validação de configuração no boot (segredo fraco, CORS em
# localhost e webhook sem segredo IMPEDEM o boot), cookie de refresh Secure e
# logs JSON. Em dev deixe vazio.
NODE_ENV=""
# "json" força logs estruturados fora de produção (em produção já é json).
LOG_FORMAT=""
# Origem(ns) do painel web, separadas por vírgula. Nunca "*".
CORS_ORIGIN="http://localhost:5173"
# Atrás de proxy/load balancer defina o número de hops (ex.: 1) ou "true";
# sem isso o rate limit e os IPs de auditoria usam o IP do proxy.
TRUST_PROXY=""

# --- Autenticação ------------------------------------------------------------
# Segredo de assinatura dos JWT (>= 32 caracteres aleatórios). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="troque-por-um-segredo-gerado"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
# SameSite do cookie de refresh do painel web: "lax" (mesmo site), "none" se o
# painel e a API estiverem em sites diferentes (exige HTTPS).
AUTH_COOKIE_SAME_SITE="lax"
# Validade do link de redefinição de senha (ex.: 30m) e URL base do painel onde
# ele abre — em produção deve apontar para o painel real.
PASSWORD_RESET_EXPIRES_IN="30m"
PASSWORD_RESET_URL="http://localhost:5173/reset-password"
# Limite de tentativas por minuto nas rotas de auth / geração de IA (testes elevam).
AUTH_THROTTLE_LIMIT=""
AI_GENERATE_THROTTLE_LIMIT=""

# --- Armazenamento (fotos de avaliação, PDFs, GIFs de exercício) -------------
# "local" (default, disco — EXIGE volume persistente) ou "s3" (AWS S3, R2, B2, MinIO).
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="../storage"
S3_BUCKET=""
S3_REGION="us-east-1"
# Só para provedores compatíveis com S3 que não são a AWS (R2, MinIO). Vazio = AWS.
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Quantos PDFs (cada um sobe um Chromium) renderizam em paralelo.
PDF_QUEUE_CONCURRENCY=2

# --- E-mail ------------------------------------------------------------------
# "console" (default: NÃO envia, só loga em dev) ou "smtp". Em produção use "smtp":
# sem isso a redefinição de senha não chega ao usuário. Valide com:
#   npm run email:test --workspace backend -- voce@seudominio.com.br
EMAIL_PROVIDER="console"
# Ex.: smtps://usuario:senha@smtp.exemplo.com:465 (qualquer provedor com SMTP).
SMTP_URL=""
# Remetente, ex.: Bocado de Nutrição <nao-responda@seudominio.com.br>
EMAIL_FROM=""

# --- Cobrança ----------------------------------------------------------------
# "mock" (default: nenhum pagamento real) ou "mercadopago" (comercial cliente:
# checkout, assinatura, webhook, consulta, cancelamento). O billing SaaS
# (planos dos profissionais) continua simulado nos dois casos.
PAYMENT_GATEWAY_PROVIDER="mock"
# Access Token da aplicação no painel do Mercado Pago (obrigatório com "mercadopago").
MERCADOPAGO_ACCESS_TOKEN=""
# Chave secreta do webhook (Suas integrações > Webhooks) — valida o header X-Signature
# de POST /client-billing/webhook. Obrigatória com "mercadopago".
MERCADOPAGO_WEBHOOK_SECRET=""
# HMAC do webhook simulado do SaaS (/billing/webhook). Troque em produção.
PAYMENT_WEBHOOK_SECRET="troque-por-um-segredo-gerado"

# --- Observabilidade ---------------------------------------------------------
# "console" (default) ou "sentry".
ERROR_TRACKING_PROVIDER="console"
SENTRY_DSN=""

# --- IA assistiva ------------------------------------------------------------
# Único provedor existente hoje: "mock-local" (simulado, sem rede). Nenhum
# provedor externo está integrado.
AI_PROVIDER="mock-local"

# --- Scripts utilitários (não usados pela API em execução) -------------------
# Criação do primeiro admin: npm run admin:bootstrap --workspace backend
ADMIN_BOOTSTRAP_EMAIL=""
ADMIN_BOOTSTRAP_NAME=""
ADMIN_BOOTSTRAP_PASSWORD=""
# Piloto de GIFs: pasta da biblioteca (somente leitura) — ver docs/OPERACAO.md.
EXERCISE_MEDIA_SOURCE_DIR=""

# --- Apps (build-time, NÃO fazem parte do backend) ---------------------------
# professional-web: VITE_API_URL=https://api.seudominio.com.br
# mobile e professional-mobile: EXPO_PUBLIC_API_URL=https://api.seudominio.com.br
