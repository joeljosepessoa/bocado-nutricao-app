DATABASE_URL="postgresql://bocado:bocado@localhost:5432/bocado_dev"

JWT_ACCESS_SECRET="troque-por-um-segredo-gerado"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

CORS_ORIGIN="http://localhost:5173"

# Diretório local para arquivos privados (fotos de avaliação). Fica fora do
# repositório e fora da pasta backend/ — trocar por um provider de object
# storage real (S3/R2) em produção é uma implementação nova do StorageService,
# sem mudar nada que o consome.
STORAGE_LOCAL_DIR="../storage"

PORT=3000
