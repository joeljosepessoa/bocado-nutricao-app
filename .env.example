DATABASE_URL="postgresql://bocado:bocado@localhost:5432/bocado_dev"

JWT_ACCESS_SECRET="troque-por-um-segredo-gerado"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

CORS_ORIGIN="http://localhost:5173"

# Diretório local para arquivos privados (fotos de avaliação, PDFs de
# relatório). Usado quando STORAGE_PROVIDER=local (default).
STORAGE_LOCAL_DIR="../storage"

# "local" (default, disco local) ou "s3" (object storage compatível com S3 —
# AWS S3, Cloudflare R2, Backblaze B2, MinIO etc.). Trocar de adapter não
# exige mudar nada que consome StorageService.
STORAGE_PROVIDER="local"
S3_BUCKET=""
S3_REGION="us-east-1"
# Só necessário para provedores compatíveis com S3 que não são a AWS (ex.:
# R2, MinIO). Deixe vazio para usar a AWS.
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Quantos PDFs de relatório (cada um sobe um processo Puppeteer) podem
# renderizar em paralelo — evita esgotar memória/CPU sob carga.
PDF_QUEUE_CONCURRENCY=2

PORT=3000

# "console" (default, loga em vez de enviar) ou "sentry". Ver ErrorTrackingService.
ERROR_TRACKING_PROVIDER="console"
SENTRY_DSN=""

# Assinatura HMAC dos webhooks de cobrança (Fase 22). Único adapter hoje é
# o mock (MockPaymentGatewayService) — troque quando um gateway de
# pagamento real for escolhido (decisão de negócio).
PAYMENT_WEBHOOK_SECRET="troque-por-um-segredo-gerado"

# "mock" (default, não fala com rede nenhuma) ou "mercadopago" (Fase 23.4 —
# só createOneTimeCheckout/createRecurringCheckout via API oficial; webhook
# e sandbox ficam para fases seguintes). Valor inválido falha no boot.
PAYMENT_GATEWAY_PROVIDER="mock"
# Obrigatório só quando PAYMENT_GATEWAY_PROVIDER=mercadopago — Access Token
# obtido em Suas integrações no painel do Mercado Pago. Nunca um valor real aqui.
MERCADOPAGO_ACCESS_TOKEN=""
