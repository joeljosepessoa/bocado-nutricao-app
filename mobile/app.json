{
  "expo": {
    "name": "Bocado de Nutrição",
    "slug": "bocado-de-nutricao-cliente",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "extra": {
      "apiUrl": "https://bocado-nutricao-app-production.up.railway.app",
      "eas": {
        "projectId": "794a06d8-05e1-42af-98b3-c1764f9155fe"
      }
    },
    "ios": {
      "bundleIdentifier": "com.bocadodenutricao.cliente",
      "supportsTablet": true,
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "Usamos notificações locais apenas para avisar quando o tempo de descanso do treino termina."
      }
    },
    "android": {
      "package": "com.bocadodenutricao.cliente",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications"
    ],
    "owner": "bocadodenutricao"
  }
}
